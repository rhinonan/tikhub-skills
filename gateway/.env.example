# 网关环境变量模板。复制为 .env 后填真实值，或直接 export。
# 密钥支持两种给法：直接给内容，或给文件路径（推荐后者）。

# ---------- 本地联调 ----------
# 1 = 跳过真实验付（只认本地凭证），上线前必须改成 0
MOCK_ALIPAY=1
# 1 = 不调用 TikHub，返回样例数据
MOCK_UPSTREAM=1

HOST=127.0.0.1
PORT=8088
GATEWAY_BASE_URL=https://your-domain.example.com
DB_PATH=./.local/gateway.db

# ---------- 卖家身份 ----------
SELLER_ID=2088000000000000
SELLER_NAME=你的服务名称
SELLER_APP_ID=2021000000000000

# ---------- 支付宝 ----------
# 沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 生产：https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_PRIVATE_KEY=./.secrets/app_private_key.txt
ALIPAY_PUBLIC_KEY=./.secrets/alipay_public_key.txt

# 支付宝按「服务」登记单价，一个 serviceId 只能对应一个价。
# 所以每档、每个任务价、每个额度包都要单独注册一个服务，共 5 个。
# 未配置时统一回落到沙箱标识 api_mock_service_id（仅联调可用）。
SERVICE_ID_STANDARD=      # ¥0.10  普通查询
SERVICE_ID_PREMIUM=       # ¥0.50  指数/星图
SERVICE_ID_BATCH=         # ¥2.00  批量
SERVICE_ID_TASK=          # ¥1.99  任务包
SERVICE_ID_PACK=          # ¥9.90  额度包

# ---------- 上游 ----------
TIKHUB_BASE=https://api.tikhub.io
TIKHUB_API_KEY=
UPSTREAM_TIMEOUT=60

# ---------- 账单 ----------
PAY_BEFORE_MINUTES=30
